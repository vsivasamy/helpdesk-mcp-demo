# Copy to .env and fill in. Never commit real values.
PORT=8000
# 0.0.0.0 in containers (default); 127.0.0.1 for local dev
HOST=127.0.0.1
# Read-only role used for every read. Neon: use the POOLED host (-pooler) with sslmode=require.
DATABASE_URL=postgresql://helpdesk_ro:CHANGE_ME@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/helpdesk?sslmode=require
# Optional bearer auth. Leave EMPTY/unset for the no-auth fake-data demo (a warning is logged).
MCP_API_KEY=
# Comma list, wildcards allowed; "*" disables Host/Origin checks
ALLOWED_HOSTS=localhost,127.0.0.1,*.azurecontainerapps.io
STATEMENT_TIMEOUT_MS=5000
# Optional write tools (create_ticket, update_status) - off by default
ENABLE_WRITES=false
DATABASE_WRITE_URL=
# Seeding only (db/seed.py): owner connection + role passwords
DATABASE_ADMIN_URL=postgresql://helpdesk_owner:CHANGE_ME@ep-xxxx.ap-southeast-1.aws.neon.tech/helpdesk?sslmode=require
HELPDESK_RO_PASSWORD=CHANGE_ME
HELPDESK_RW_PASSWORD=
SEED_TICKETS=400
